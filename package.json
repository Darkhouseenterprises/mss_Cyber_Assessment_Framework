{
  "name": "mss-cyber-assessment-framework",
  "version": "0.1.0",
  "private": false,
  "description": "Machine Simplified Schema of NCSC CAF v3.2 and v4.0 with outcome mapping. Zod-validated citation backbone for LLMs.",
  "type": "module",
  "license": "(MIT AND OGL-UK-3.0)",
  "author": "Darkhouse Enterprises Ltd",
  "repository": {
    "type": "git",
    "url": "https://github.com/Darkhouseenterprises/mss_Cyber_Assessment_Framework.git"
  },
  "homepage": "https://github.com/Darkhouseenterprises/mss_Cyber_Assessment_Framework",
  "keywords": [
    "mss",
    "caf",
    "ncsc",
    "cyber-assessment-framework",
    "uk-government",
    "schema",
    "zod",
    "llm"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
